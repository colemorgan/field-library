+// How sync requests reach the server. PHONE relays them over Bluetooth through
+// the Field Sync phone app; AUTO tries the saved Wi-Fi first, then the phone.
+enum class SyncTransportMode : uint8_t {
+  WIFI = 0,
+  PHONE = 1,
+  AUTO = 2,
+};

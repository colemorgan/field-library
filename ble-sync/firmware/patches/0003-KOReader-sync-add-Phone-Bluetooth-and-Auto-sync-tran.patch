+
+bool KOReaderSyncActivity::startAutoWifi() {
+  WIFI_STORE.loadFromFile();
+  const std::string lastSsid = WIFI_STORE.getLastConnectedSsid();
+  const auto cred = lastSsid.empty() ? std::nullopt : WIFI_STORE.findCredential(lastSsid);
+  if (!cred) {
+    LOG_DBG("KOSync", "Auto transport: no saved Wi-Fi, using the phone");
+    return false;
+  }
+  LOG_DBG("KOSync", "Auto transport: trying saved Wi-Fi %s", cred->ssid.c_str());
+  wifiActivated = true;
+  WiFi.persistent(false);
+  WiFi.mode(WIFI_STA);
+  if (cred->password.empty()) {
+    WiFi.begin(cred->ssid.c_str());
+  } else {
+    WiFi.begin(cred->ssid.c_str(), cred->password.c_str());
+  }
+  {
+    RenderLock lock(*this);
+    state = AUTO_WIFI;
+    statusMessage = tr(STR_CONNECTING_SAVED_WIFI);
+  }
+  autoWifiStartMs = millis();
+  requestUpdate();
+  return true;
+}
+
+void KOReaderSyncActivity::loopAutoWifi() {
+  if (WiFi.status() == WL_CONNECTED) {
+    onWifiSelectionComplete(true);
+    return;
+  }
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    returnToReader();
+    return;
+  }
+  if (millis() - autoWifiStartMs < AUTO_WIFI_TIMEOUT_MS) return;
+  LOG_DBG("KOSync", "Auto transport: saved Wi-Fi not reached, using the phone");
+  // Wi-Fi and Bluetooth never run together: release the Wi-Fi driver first.
+  WiFi.disconnect(true);
+  WiFi.mode(WIFI_OFF);
+  startPhoneSync();
+}
+
+void KOReaderSyncActivity::startPhoneSync() {
+  // The page turner owns NimBLE outside this screen; it is already stopped for the
+  // screen change, and this makes sure no stop is still in flight.
+  if (!bleturner::stopNow(2000)) {
+    LOG_ERR("KOSync", "Page turner radio did not stop; cannot start Field Sync");
+    failSync(tr(STR_BT_START_FAILED));
+    return;
+  }
+  phone = std::make_unique<fieldsync::BlePeripheral>();
+  if (!phone->start(KOREADER_STORE.getBaseUrl(), CROSSPOINT_VERSION "+field-ble")) {
+    phone.reset();
+    failSync(tr(STR_BT_START_FAILED));
+    return;
+  }
+  relay = std::make_unique<fieldsync::RelayTransport>(*phone);
+  {
+    RenderLock lock(*this);
+    phoneName = phone->deviceName();
+    shownPasskey = -1;
+    state = PHONE_WAITING;
+  }
+  requestUpdate(true);
+}
+
+void KOReaderSyncActivity::loopPhoneWaiting() {
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    finishPhone("cancel");
+    returnToReader();
+    return;
+  }
+  const auto phase = phone->poll();
+  const int32_t passkey = phone->passkey();
+  if (passkey != shownPasskey) {
+    {
+      RenderLock lock(*this);
+      shownPasskey = passkey;
+    }
+    requestUpdate(true);
+  }
+
+  switch (phase) {
+    case fieldsync::BlePeripheral::Phase::Ready:
+      LOG_DBG("KOSync", "Phone ready, starting sync over Bluetooth");
+      KOReaderSyncClient::setTransport(relay.get());
+      {
+        RenderLock lock(*this);
+        state = SYNCING;
+        statusMessage = tr(STR_CALC_HASH);
+      }
+      requestUpdate(true);
+      performSync();
+      return;
+    case fieldsync::BlePeripheral::Phase::TimedOut:
+      finishPhone("timeout");
+      failSync(tr(STR_FIELD_SYNC_NO_PHONE));
+      return;
+    case fieldsync::BlePeripheral::Phase::Failed: {
+      const auto failure = phone->failure();
+      finishPhone("error");
+      failSync(failure == fieldsync::BlePeripheral::Failure::Version     ? tr(STR_FIELD_SYNC_VERSION)
+               : failure == fieldsync::BlePeripheral::Failure::PhoneLeft ? tr(STR_FIELD_SYNC_PHONE_LEFT)
+                                                                         : tr(STR_BT_FAILED));
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+void KOReaderSyncActivity::finishPhone(const char* reason) {
+  if (!phone) return;
+  KOReaderSyncClient::setTransport(nullptr);
+  phone->sendBye(reason);
+  phone->stop();
+  relay.reset();
+  phone.reset();
+  // No render lock here: onExit() runs with it held. PHONE_WAITING, the only
+  // state that draws the passkey, is never current once the phone is gone.
+  shownPasskey = -1;
+}
+#else
+bool KOReaderSyncActivity::usingPhone() const { return false; }
+#endif

   for (const auto& header : KOREADER_STORE.getCustomHeaders()) {
-    if (!header.name.empty()) http.addHeader(header.name, header.value);
+    if (!header.name.empty()) request.headers.emplace_back(header.name, header.value);
   }
 }
 
+// The upstream transport: one HTTPS request per call over the active Wi-Fi link.
+class WifiHttpsTransport final : public KOSyncTransport {
+ public:
+  int perform(const KOSyncRequest& request, std::string* responseBody) override {
+    const std::string url = KOREADER_STORE.getBaseUrl() + request.path;
+    freeink::SecureHttpClient http;
+    http.setInsecure();
+    if (!http.begin(url)) {
+      LOG_ERR("KOSync", "Bad URL: %s", url.c_str());
+      return -1;
+    }
+    for (const auto& header : request.headers) http.addHeader(header.first, header.second);
+    const int httpCode = request.body ? http.sendRequest(request.method, *request.body) : http.GET();
+    if (responseBody && httpCode > 0) *responseBody = http.getString();
+    http.end();
+    return httpCode;
+  }
+  bool needsTlsHeap() const override { return true; }
+};
+
+WifiHttpsTransport wifiTransport;
+KOSyncTransport* activeTransport = &wifiTransport;
+
 // True when free heap is too low to risk a TLS handshake.
 bool insufficientHeap() {
   const auto heap = HalMemory::getDefaultHeap();
@@ -55,8 +79,14 @@ bool insufficientHeap() {
   }
   return false;
 }
+
+bool lowMemoryForTransport() { return activeTransport->needsTlsHeap() && insufficientHeap(); }
 }  // namespace
 
+void KOReaderSyncClient::setTransport(KOSyncTransport* transport) {
+  activeTransport = transport ? transport : &wifiTransport;
+}

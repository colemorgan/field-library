@@ -0,0 +1,24 @@
+#pragma once
+#include <string>
+#include <utility>
+#include <vector>
+
+// One KOSync HTTP request, independent of how it reaches the server.
+struct KOSyncRequest {
+  const char* method = "GET";
+  std::string path;  // starts with '/', appended to the configured base URL
+  std::vector<std::pair<std::string, std::string>> headers;
+  const std::string* body = nullptr;  // null: no body
+};
+
+// Carries KOSync requests to the server. The default sends them over Wi-Fi
+// HTTPS; a relay can carry them over another link instead.
+class KOSyncTransport {
+ public:
+  virtual ~KOSyncTransport() = default;
+  // Returns the HTTP status, or <= 0 when no response arrived. The response
+  // body is written to responseBody when it is not null.
+  virtual int perform(const KOSyncRequest& request, std::string* responseBody) = 0;
+  // True when a request opens a TLS session on this device (heap preflight).
+  virtual bool needsTlsHeap() const { return false; }
+};

diff --git a/lib/FieldBleSync/include/FieldBlePeripheral.h b/lib/FieldBleSync/include/FieldBlePeripheral.h
new file mode 100644
index 0000000..4dd2005
--- /dev/null
+++ b/lib/FieldBleSync/include/FieldBlePeripheral.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#if defined(FIELD_BLE_SYNC) && FIELD_BLE_SYNC
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "FieldSyncFraming.h"
+#include "FieldSyncRelay.h"
+
+namespace fieldsync {
+
+// The reader's GATT peripheral for Field Sync (ble-sync/PROTOCOL.md). It owns
+// the NimBLE stack from start() to stop(): the Bluetooth page turner must be
+// stopped first, and nothing else may start NimBLE meanwhile.
+//
+// Threads: start, poll, stop, sendBye and the RelayLink calls run on one task
+// (the main loop). NimBLE callbacks run on the NimBLE host task and only touch
+// the atomics and the inbox below.
+class BlePeripheral final : public RelayLink {
+ public:
+  static constexpr uint32_t ADVERTISE_TIMEOUT_MS = 60000;
+  static constexpr uint16_t PREFERRED_MTU = 247;
+
+  enum class Phase : uint8_t {
+    Off,
+    Advertising,  // waiting for the phone
+    Connected,    // phone linked; pairing and hello pending
+    Ready,        // encrypted, bonded, hello exchanged: requests may flow
+    TimedOut,     // no phone within ADVERTISE_TIMEOUT_MS
+    Failed,       // see failure()
+  };
+  enum class Failure : uint8_t { None, StackStart, Version, Oversize, PhoneLeft, Insecure };
+
+  BlePeripheral();
+  ~BlePeripheral() override;
+  BlePeripheral(const BlePeripheral&) = delete;
+  BlePeripheral& operator=(const BlePeripheral&) = delete;
+
+  // Starts NimBLE, the service and advertising. False when the stack was
+  // already up (another owner) or failed to start.
+  bool start(const std::string& baseUrl, const char* firmware);
+  // Drives the handshake and the advertising timeout. Call every loop pass.
+  Phase poll();
+  Phase phase() const { return currentPhase; }
+  Failure failure() const { return currentFailure; }
+  // The pairing passkey to show (0..999999), or -1 when none is pending.
+  int32_t passkey() const { return pairingPasskey.load(std::memory_order_acquire); }
+  const std::string& deviceName() const { return name; }
+
+  // Sends {"t":"bye"} when the link is ready. Then call stop().
+  void sendBye(const char* reason);
+  // Disconnects, stops advertising and releases the NimBLE host and controller.
+  // Idempotent; call from the task that called start().
+  void stop();
+
+  bool send(const std::string& message) override;
+  Wait receive(std::string& out, uint32_t timeoutMs) override;
+  uint32_t nowMs() override;
+
+  // NimBLE host task entry points (see FieldBlePeripheral.cpp).
+  struct Callbacks;
+
+ private:
+  void restartAdvertising();
+  void fail(Failure failure);
+  bool takeMessage(std::string& out);
+  void handshake();
+
+  std::unique_ptr<Callbacks> callbacks;
+  std::string name;
+  std::string baseUrl;
+  std::string firmware;
+  Phase currentPhase = Phase::Off;
+  Failure currentFailure = Failure::None;
+  uint32_t advertiseStartMs = 0;
+  uint8_t nextMsgId = 0;
+  bool running = false;
+
+  // Written by the NimBLE host task.
+  std::atomic<uint16_t> connHandle;
+  std::atomic<uint16_t> mtu{MIN_ATT_MTU};
+  std::atomic<bool> secure{false};
+  std::atomic<bool> peerLeft{false};
+  std::atomic<bool> oversize{false};
+  std::atomic<int32_t> pairingPasskey{-1};
+  Reassembler rx;  // host task only
+  std::mutex inboxLock;
+  std::deque<std::string> inbox;
+};
+
+}  // namespace fieldsync
+
+#endif
diff --git a/lib/FieldBleSync/include/FieldSyncFraming.h b/lib/FieldBleSync/include/FieldSyncFraming.h
new file mode 100644
index 0000000..0fee334
--- /dev/null
+++ b/lib/FieldBleSync/include/FieldSyncFraming.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// Chunk framing of the Field Sync relay (ble-sync/PROTOCOL.md, "Framing"):
+// byte 0 flags (bit0 FIRST, bit1 LAST), byte 1 msgId, then payload bytes.
+namespace fieldsync {
+
+inline constexpr uint8_t FLAG_FIRST = 0x01;
+inline constexpr uint8_t FLAG_LAST = 0x02;
+inline constexpr size_t HEADER_BYTES = 2;
+inline constexpr uint16_t MIN_ATT_MTU = 23;
+inline constexpr size_t MAX_MESSAGE_BYTES = 16384;
+inline constexpr uint32_t CHUNK_GAP_TIMEOUT_MS = 5000;
+
+// Largest chunk for an ATT MTU (MTU - 3), never below the 23-byte minimum.
+size_t chunkSizeForMtu(uint16_t mtu);
+
+// Receives one encoded chunk; false stops the encoding.
+using ChunkSink = bool (*)(const uint8_t* chunk, size_t length, void* context);
+
+// Splits one message into chunks of at most chunkSizeForMtu(mtu) bytes and hands
+// each to sink. False when the message is over MAX_MESSAGE_BYTES or sink failed.
+bool encodeMessage(uint8_t msgId, const uint8_t* message, size_t length, uint16_t mtu, ChunkSink sink, void* context);
+
+// Rebuilds messages from chunks of one characteristic. Raw bytes are kept until
+// the LAST chunk, so a UTF-8 sequence split across chunks stays intact.
+class Reassembler {
+ public:
+  enum class Result : uint8_t {
+    Partial,   // chunk stored; the message continues
+    Complete,  // message() holds a whole message until the next feed()
+    Ignored,   // not part of a message in progress (malformed, stale or unknown msgId)
+    TooLarge,  // the message passed MAX_MESSAGE_BYTES and was dropped
+  };
+
+  Result feed(const uint8_t* chunk, size_t length, uint32_t nowMs);
+  // Drops a partial message once CHUNK_GAP_TIMEOUT_MS passed since its last chunk.
+  // True when one was dropped.
+  bool expire(uint32_t nowMs);
+  void reset();
+
+  const std::string& message() const { return buffer; }
+  bool inProgress() const { return active; }
+
+ private:
+  std::string buffer;
+  bool active = false;
+  uint8_t msgId = 0;
+  uint32_t lastChunkMs = 0;
+};
+
+}  // namespace fieldsync
diff --git a/lib/FieldBleSync/include/FieldSyncMessages.h b/lib/FieldBleSync/include/FieldSyncMessages.h
new file mode 100644
index 0000000..f8dbe5e
--- /dev/null
+++ b/lib/FieldBleSync/include/FieldSyncMessages.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include "KOReaderSyncTransport.h"
+
+// JSON messages of the Field Sync relay (ble-sync/PROTOCOL.md, "Messages").
+namespace fieldsync {
+
+inline constexpr int PROTOCOL_VERSION = 1;
+
+std::string buildHello(const char* device, const char* firmware, const std::string& baseUrl);
+std::string buildRequest(uint16_t id, const KOSyncRequest& request);
+std::string buildBye(const char* reason);
+std::string buildError(const char* code, const char* message);
+
+enum class MessageType : uint8_t { Invalid, Unknown, Hello, Response, Bye, Error };
+
+// One message from the phone. Fields not used by its type stay at their defaults.
+struct Incoming {
+  MessageType type = MessageType::Invalid;
+  int version = 0;       // hello
+  uint32_t id = 0;       // res
+  int status = 0;        // res
+  bool hasBody = false;  // res: false when body was null or absent
+  std::string body;      // res
+  std::string error;     // res with status 0
+  std::string code;      // error
+  std::string text;      // error message, bye reason
+};
+
+// Invalid: not a JSON object with a string "t". Unknown: another "t".
+Incoming parseIncoming(const std::string& json);
+
+// True when a hello's major version matches PROTOCOL_VERSION.
+inline bool versionCompatible(const int version) { return version == PROTOCOL_VERSION; }
+
+}  // namespace fieldsync
diff --git a/lib/FieldBleSync/include/FieldSyncRelay.h b/lib/FieldBleSync/include/FieldSyncRelay.h
new file mode 100644
index 0000000..9069ca3
--- /dev/null
+++ b/lib/FieldBleSync/include/FieldSyncRelay.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include "KOReaderSyncTransport.h"
+
+namespace fieldsync {
+
+inline constexpr uint32_t RESPONSE_TIMEOUT_MS = 30000;
+
+// A message link to the phone: whole JSON messages, already framed and reassembled.
+class RelayLink {
+ public:
+  enum class Wait : uint8_t {
+    Message,  // out holds one complete message
+    Timeout,  // nothing arrived in time
+    Closed,   // the phone disconnected or the link failed (e.g. an oversize message)
+  };
+
+  virtual ~RelayLink() = default;
+  virtual bool send(const std::string& message) = 0;
+  // Waits at most timeoutMs for the next message from the phone.
+  virtual Wait receive(std::string& out, uint32_t timeoutMs) = 0;
+  virtual uint32_t nowMs() = 0;
+};
+
+// Carries KOSync requests to the phone as "req" messages and waits for the
+// matching "res". One request at a time; ids run 1..65535 and wrap.
+class RelayTransport final : public KOSyncTransport {
+ public:
+  explicit RelayTransport(RelayLink& link, uint32_t timeoutMs = RESPONSE_TIMEOUT_MS)
+      : link(link), timeoutMs(timeoutMs) {}
+
+  // HTTP status; 0 when the phone answered status 0 (it could not reach the
+  // server); -1 on timeout or a closed link. Both map to NETWORK_ERROR.
+  int perform(const KOSyncRequest& request, std::string* responseBody) override;
+
+  // The link is gone (phone left, sent bye/error, or oversize data): later
+  // requests fail at once.
+  bool closed() const { return linkClosed; }
+  // The phone's error code from the last failed request ("network", "timeout", ...), if any.
+  const std::string& lastError() const { return error; }
+
+ private:
+  RelayLink& link;
+  uint32_t timeoutMs;
+  uint16_t nextId = 1;
+  bool linkClosed = false;
+  std::string error;
+};
+
+}  // namespace fieldsync

diff --git a/lib/FieldBleSync/src/FieldBlePeripheral.cpp b/lib/FieldBleSync/src/FieldBlePeripheral.cpp
new file mode 100644
index 0000000..7800c3b
--- /dev/null
+++ b/lib/FieldBleSync/src/FieldBlePeripheral.cpp
@@ -0,0 +1,338 @@
+#include "FieldBlePeripheral.h"
+
+#if defined(FIELD_BLE_SYNC) && FIELD_BLE_SYNC
+
+#include <Arduino.h>
+#include <Logging.h>
+#include <NimBLEDevice.h>
+#include <esp_random.h>
+
+#include <algorithm>
+#include <cctype>
+#include <utility>
+
+#include "FieldSyncMessages.h"
+
+namespace fieldsync {
+
+namespace {
+constexpr char SERVICE_UUID[] = "6f1d0001-5a1e-4c8b-9f3e-2b7c1a0e5d10";
+constexpr char RX_UUID[] = "6f1d0002-5a1e-4c8b-9f3e-2b7c1a0e5d10";
+constexpr char TX_UUID[] = "6f1d0003-5a1e-4c8b-9f3e-2b7c1a0e5d10";
+constexpr char DEVICE[] = "CrossPoint";
+// A request and its answer are in flight at once at most; more queued messages
+// mean a misbehaving phone, and the oldest are dropped.
+constexpr size_t INBOX_LIMIT = 4;
+// A notification that finds NimBLE's buffers full is retried for this long.
+constexpr uint32_t NOTIFY_RETRY_MS = 2000;
+// Time for the last notification (bye) to leave before the link is closed.
+constexpr uint32_t BYE_DRAIN_MS = 300;
+constexpr uint32_t DISCONNECT_WAIT_MS = 1000;
+}  // namespace
+
+struct BlePeripheral::Callbacks final : public NimBLEServerCallbacks, public NimBLECharacteristicCallbacks {
+  explicit Callbacks(BlePeripheral& owner) : owner(owner) {}
+
+  BlePeripheral& owner;
+  NimBLEServer* server = nullptr;
+  NimBLECharacteristic* tx = nullptr;
+
+  void onConnect(NimBLEServer*, NimBLEConnInfo& info) override {
+    owner.rx.reset();
+    owner.secure.store(false, std::memory_order_release);
+    owner.peerLeft.store(false, std::memory_order_release);
+    owner.mtu.store(std::max<uint16_t>(info.getMTU(), MIN_ATT_MTU), std::memory_order_release);
+    owner.connHandle.store(info.getConnHandle(), std::memory_order_release);
+    // A bonded phone re-encrypts here; a new one is asked to pair (passkey on screen).
+    NimBLEDevice::startSecurity(info.getConnHandle());
+  }
+
+  void onDisconnect(NimBLEServer*, NimBLEConnInfo& info, const int reason) override {
+    if (info.getConnHandle() != owner.connHandle.load(std::memory_order_acquire)) return;
+    LOG_DBG("FSYNC", "Phone disconnected (reason %d)", reason);
+    owner.connHandle.store(BLE_HS_CONN_HANDLE_NONE, std::memory_order_release);
+    owner.secure.store(false, std::memory_order_release);
+    owner.pairingPasskey.store(-1, std::memory_order_release);
+    owner.peerLeft.store(true, std::memory_order_release);
+  }
+
+  void onMTUChange(const uint16_t value, NimBLEConnInfo&) override {
+    owner.mtu.store(std::max<uint16_t>(value, MIN_ATT_MTU), std::memory_order_release);
+  }
+
+  uint32_t onPassKeyDisplay() override {
+    const auto key = static_cast<int32_t>(esp_random() % 1000000u);
+    owner.pairingPasskey.store(key, std::memory_order_release);
+    return static_cast<uint32_t>(key);
+  }
+
+  void onAuthenticationComplete(NimBLEConnInfo& info) override {
+    owner.pairingPasskey.store(-1, std::memory_order_release);
+    // Sync credentials travel over this link: refuse anything below an
+    // encrypted, MITM-authenticated, bonded link.
+    if (info.isEncrypted() && info.isAuthenticated() && info.isBonded()) {
+      owner.secure.store(true, std::memory_order_release);
+      return;
+    }
+    LOG_ERR("FSYNC", "Link not secure (enc=%d auth=%d bond=%d); disconnecting", info.isEncrypted(),
+            info.isAuthenticated(), info.isBonded());
+    if (server) server->disconnect(info.getConnHandle());
+  }
+
+  void onWrite(NimBLECharacteristic* characteristic, NimBLEConnInfo& info) override {
+    if (!owner.secure.load(std::memory_order_acquire) || !info.isEncrypted()) return;
+    const NimBLEAttValue value = characteristic->getValue();
+    switch (owner.rx.feed(value.data(), value.size(), millis())) {
+      case Reassembler::Result::Complete: {
+        std::lock_guard<std::mutex> lock(owner.inboxLock);
+        if (owner.inbox.size() >= INBOX_LIMIT) owner.inbox.pop_front();
+        owner.inbox.push_back(owner.rx.message());
+        break;
+      }
+      case Reassembler::Result::TooLarge:
+        owner.oversize.store(true, std::memory_order_release);
+        break;
+      default:
+        break;
+    }
+  }
+};
+
+BlePeripheral::BlePeripheral() : callbacks(new Callbacks(*this)), connHandle(BLE_HS_CONN_HANDLE_NONE) {}
+
+BlePeripheral::~BlePeripheral() { stop(); }
+
+uint32_t BlePeripheral::nowMs() { return millis(); }
+
+bool BlePeripheral::start(const std::string& serverBaseUrl, const char* firmwareVersion) {
+  if (running) return true;
+  if (NimBLEDevice::isInitialized()) {
+    LOG_ERR("FSYNC", "NimBLE already running; refusing to take it over");
+    return false;
+  }
+  baseUrl = serverBaseUrl;
+  firmware = firmwareVersion ? firmwareVersion : "";
+  currentFailure = Failure::None;
+
+  if (!NimBLEDevice::init("FieldSync")) {
+    LOG_ERR("FSYNC", "NimBLE init failed");
+    fail(Failure::StackStart);
+    return false;
+  }
+  running = true;
+
+  // FieldSync-XXXX: the last two address bytes, as printed "aa:bb:cc:dd:EE:FF".
+  std::string addr = NimBLEDevice::getAddress().toString();
+  std::string suffix;
+  for (size_t i = addr.size() >= 5 ? addr.size() - 5 : 0; i < addr.size(); ++i) {
+    if (addr[i] != ':') suffix.push_back(static_cast<char>(std::toupper(static_cast<unsigned char>(addr[i]))));
+  }
+  name = "FieldSync-" + suffix;
+  NimBLEDevice::setDeviceName(name);
+  NimBLEDevice::setMTU(PREFERRED_MTU);
+
+  // LE Secure Connections with MITM: the reader displays, the phone types.
+  NimBLEDevice::setSecurityAuth(/*bonding=*/true, /*mitm=*/true, /*sc=*/true);
+  NimBLEDevice::setSecurityIOCap(BLE_HS_IO_DISPLAY_ONLY);
+  // 123456 makes NimBLE ask onPassKeyDisplay() for a fresh key on each pairing.
+  NimBLEDevice::setSecurityPasskey(123456);
+  NimBLEDevice::setSecurityInitKey(BLE_SM_PAIR_KEY_DIST_ENC | BLE_SM_PAIR_KEY_DIST_ID);
+  NimBLEDevice::setSecurityRespKey(BLE_SM_PAIR_KEY_DIST_ENC | BLE_SM_PAIR_KEY_DIST_ID);
+
+  NimBLEServer* server = NimBLEDevice::createServer();
+  server->setCallbacks(callbacks.get(), false);
+  server->advertiseOnDisconnect(false);
+  NimBLEService* service = server->createService(SERVICE_UUID);
+  NimBLECharacteristic* rxChr =
+      service->createCharacteristic(RX_UUID, NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::WRITE_NR |
+                                                 NIMBLE_PROPERTY::WRITE_ENC | NIMBLE_PROPERTY::WRITE_AUTHEN);
+  rxChr->setCallbacks(callbacks.get());
+  callbacks->tx = service->createCharacteristic(TX_UUID, NIMBLE_PROPERTY::NOTIFY);
+  callbacks->server = server;
+  server->start();
+
+  NimBLEAdvertisementData advData;
+  advData.setFlags(BLE_HS_ADV_F_DISC_GEN | BLE_HS_ADV_F_BREDR_UNSUP);
+  advData.addServiceUUID(NimBLEUUID(SERVICE_UUID));
+  NimBLEAdvertisementData scanData;
+  scanData.setName(name);
+  NimBLEAdvertising* adv = NimBLEDevice::getAdvertising();
+  adv->setAdvertisementData(advData);
+  adv->setScanResponseData(scanData);
+
+  restartAdvertising();
+  if (currentPhase != Phase::Advertising) {
+    stop();
+    fail(Failure::StackStart);
+    return false;
+  }
+  LOG_INF("FSYNC", "Advertising as %s", name.c_str());
+  return true;
+}
+
+void BlePeripheral::restartAdvertising() {
+  peerLeft.store(false, std::memory_order_release);
+  {
+    std::lock_guard<std::mutex> lock(inboxLock);
+    inbox.clear();
+  }
+  advertiseStartMs = millis();
+  if (NimBLEDevice::getAdvertising()->start(ADVERTISE_TIMEOUT_MS)) {
+    currentPhase = Phase::Advertising;
+  } else {
+    LOG_ERR("FSYNC", "Advertising start failed");
+    fail(Failure::StackStart);
+  }
+}
+
+void BlePeripheral::fail(const Failure failure) {
+  currentFailure = failure;
+  currentPhase = Phase::Failed;
+}
+
+bool BlePeripheral::takeMessage(std::string& out) {
+  std::lock_guard<std::mutex> lock(inboxLock);
+  if (inbox.empty()) return false;
+  out = std::move(inbox.front());
+  inbox.pop_front();
+  return true;
+}
+
+void BlePeripheral::handshake() {
+  if (!secure.load(std::memory_order_acquire)) return;
+  std::string message;
+  while (takeMessage(message)) {
+    const Incoming in = parseIncoming(message);
+    if (in.type != MessageType::Hello) continue;  // nothing else is valid before hello
+    if (!versionCompatible(in.version)) {
+      LOG_ERR("FSYNC", "Phone protocol v%d, reader v%d", in.version, PROTOCOL_VERSION);
+      send(buildError("version", nullptr));
+      fail(Failure::Version);
+      return;
+    }
+    if (!send(buildHello(DEVICE, firmware.c_str(), baseUrl))) return;  // the link dropped; poll() sees it
+    LOG_INF("FSYNC", "Phone ready (MTU %u)", mtu.load());
+    currentPhase = Phase::Ready;
+    return;
+  }
+}
+
+BlePeripheral::Phase BlePeripheral::poll() {
+  if (!running) return currentPhase;
+  if (oversize.load(std::memory_order_acquire)) {
+    LOG_ERR("FSYNC", "Phone sent a message over %u bytes", static_cast<unsigned>(MAX_MESSAGE_BYTES));
+    send(buildError("too_large", nullptr));
+    fail(Failure::Oversize);
+    return currentPhase;
+  }
+  const bool linked = connHandle.load(std::memory_order_acquire) != BLE_HS_CONN_HANDLE_NONE;
+  switch (currentPhase) {
+    case Phase::Advertising:
+      if (linked) {
+        currentPhase = Phase::Connected;
+      } else if (millis() - advertiseStartMs >= ADVERTISE_TIMEOUT_MS) {
+        NimBLEDevice::getAdvertising()->stop();
+        currentPhase = Phase::TimedOut;
+      }
+      break;
+    case Phase::Connected:
+      // A phone that leaves before the hello (pairing cancelled, wrong passkey)
+      // may try again: advertise for a fresh window.
+      if (peerLeft.load(std::memory_order_acquire)) {
+        restartAdvertising();
+        break;
+      }
+      handshake();
+      break;
+    case Phase::Ready:
+      if (peerLeft.load(std::memory_order_acquire)) fail(Failure::PhoneLeft);
+      break;
+    default:
+      break;
+  }
+  return currentPhase;
+}
+
+namespace {
+struct NotifyTarget {
+  NimBLECharacteristic* tx;
+  uint16_t conn;
+};
+
+bool notifyChunk(const uint8_t* chunk, const size_t length, void* context) {
+  const auto* target = static_cast<NotifyTarget*>(context);
+  const uint32_t startMs = millis();
+  // notify() fails while NimBLE's mbuf pool is full; it drains as packets leave.
+  while (!target->tx->notify(chunk, length, target->conn)) {
+    if (millis() - startMs >= NOTIFY_RETRY_MS) return false;
+    delay(5);
+  }
+  return true;
+}
+}  // namespace
+
+bool BlePeripheral::send(const std::string& message) {
+  const uint16_t conn = connHandle.load(std::memory_order_acquire);
+  if (!running || conn == BLE_HS_CONN_HANDLE_NONE || !secure.load(std::memory_order_acquire) || !callbacks->tx) {
+    return false;
+  }
+  NotifyTarget target{callbacks->tx, conn};
+  if (!encodeMessage(nextMsgId++, reinterpret_cast<const uint8_t*>(message.data()), message.size(),
+                     mtu.load(std::memory_order_acquire), notifyChunk, &target)) {
+    LOG_ERR("FSYNC", "Send of %u bytes failed", static_cast<unsigned>(message.size()));
+    return false;
+  }
+  return true;
+}
+
+RelayLink::Wait BlePeripheral::receive(std::string& out, const uint32_t timeoutMs) {
+  const uint32_t startMs = millis();
+  for (;;) {
+    if (takeMessage(out)) return Wait::Message;
+    if (!running || peerLeft.load(std::memory_order_acquire) || oversize.load(std::memory_order_acquire)) {
+      return Wait::Closed;
+    }
+    if (millis() - startMs >= timeoutMs) return Wait::Timeout;
+    delay(10);
+  }
+}
+
+void BlePeripheral::sendBye(const char* reason) {
+  if (!running || connHandle.load(std::memory_order_acquire) == BLE_HS_CONN_HANDLE_NONE) return;
+  if (send(buildBye(reason))) delay(BYE_DRAIN_MS);
+}
+
+void BlePeripheral::stop() {
+  if (!running) return;
+  running = false;
+  const uint16_t conn = connHandle.load(std::memory_order_acquire);
+  if (conn != BLE_HS_CONN_HANDLE_NONE && callbacks->server) {
+    callbacks->server->disconnect(conn);
+    const uint32_t startMs = millis();
+    while (connHandle.load(std::memory_order_acquire) != BLE_HS_CONN_HANDLE_NONE &&
+           millis() - startMs < DISCONNECT_WAIT_MS) {
+      delay(10);
+    }
+  }
+  NimBLEAdvertising* adv = NimBLEDevice::getAdvertising();
+  if (adv && adv->isAdvertising()) adv->stop();
+  callbacks->tx = nullptr;
+  callbacks->server = nullptr;
+  // Frees the NimBLE host and controller; the bond stays in NVS.
+  NimBLEDevice::deinit(true);
+  if (NimBLEDevice::isInitialized()) LOG_ERR("FSYNC", "NimBLE deinit did not complete");
+  connHandle.store(BLE_HS_CONN_HANDLE_NONE, std::memory_order_release);
+  secure.store(false, std::memory_order_release);
+  pairingPasskey.store(-1, std::memory_order_release);
+  rx.reset();
+  {
+    std::lock_guard<std::mutex> lock(inboxLock);
+    inbox.clear();
+  }
+  if (currentPhase != Phase::Failed && currentPhase != Phase::TimedOut) currentPhase = Phase::Off;
+  LOG_DBG("FSYNC", "Bluetooth stopped (heap: %u)", static_cast<unsigned>(ESP.getFreeHeap()));
+}
+
+}  // namespace fieldsync
+
+#endif
diff --git a/lib/FieldBleSync/src/FieldSyncFraming.cpp b/lib/FieldBleSync/src/FieldSyncFraming.cpp
new file mode 100644
index 0000000..2c04600
--- /dev/null
+++ b/lib/FieldBleSync/src/FieldSyncFraming.cpp
@@ -0,0 +1,76 @@
+#include "FieldSyncFraming.h"
+
+#include <algorithm>
+
+namespace fieldsync {
+
+size_t chunkSizeForMtu(const uint16_t mtu) { return static_cast<size_t>(std::max(mtu, MIN_ATT_MTU)) - 3; }
+
+bool encodeMessage(const uint8_t msgId, const uint8_t* message, const size_t length, const uint16_t mtu,
+                   const ChunkSink sink, void* context) {
+  if (length > MAX_MESSAGE_BYTES || sink == nullptr) return false;
+  const size_t payloadMax = chunkSizeForMtu(mtu) - HEADER_BYTES;
+  uint8_t chunk[HEADER_BYTES + 512];
+  const size_t payloadCap = std::min(payloadMax, sizeof(chunk) - HEADER_BYTES);
+  size_t offset = 0;
+  do {
+    const size_t take = std::min(payloadCap, length - offset);
+    uint8_t flags = 0;
+    if (offset == 0) flags |= FLAG_FIRST;
+    if (offset + take == length) flags |= FLAG_LAST;
+    chunk[0] = flags;
+    chunk[1] = msgId;
+    if (take > 0) std::copy(message + offset, message + offset + take, chunk + HEADER_BYTES);
+    if (!sink(chunk, HEADER_BYTES + take, context)) return false;
+    offset += take;
+  } while (offset < length);
+  return true;
+}
+
+Reassembler::Result Reassembler::feed(const uint8_t* chunk, const size_t length, const uint32_t nowMs) {
+  if (chunk == nullptr || length < HEADER_BYTES) return Result::Ignored;
+  const uint8_t flags = chunk[0];
+  const uint8_t id = chunk[1];
+  const uint8_t* payload = chunk + HEADER_BYTES;
+  const size_t payloadLength = length - HEADER_BYTES;
+
+  if (flags & FLAG_FIRST) {
+    // FIRST discards whatever was partially received.
+    buffer.clear();
+    active = true;
+    msgId = id;
+  } else {
+    expire(nowMs);
+    if (!active || id != msgId) {
+      reset();
+      return Result::Ignored;
+    }
+  }
+
+  if (buffer.size() + payloadLength > MAX_MESSAGE_BYTES) {
+    reset();
+    return Result::TooLarge;
+  }
+  buffer.append(reinterpret_cast<const char*>(payload), payloadLength);
+  lastChunkMs = nowMs;
+
+  if (flags & FLAG_LAST) {
+    active = false;
+    return Result::Complete;
+  }
+  return Result::Partial;
+}
+
+bool Reassembler::expire(const uint32_t nowMs) {
+  if (!active || nowMs - lastChunkMs <= CHUNK_GAP_TIMEOUT_MS) return false;
+  reset();
+  return true;
+}
+
+void Reassembler::reset() {
+  // Release the storage too: a dropped 16 KB message should not stay allocated.
+  std::string().swap(buffer);
+  active = false;
+}
+
+}  // namespace fieldsync
diff --git a/lib/FieldBleSync/src/FieldSyncMessages.cpp b/lib/FieldBleSync/src/FieldSyncMessages.cpp
new file mode 100644
index 0000000..6797d96
--- /dev/null
+++ b/lib/FieldBleSync/src/FieldSyncMessages.cpp
@@ -0,0 +1,115 @@
+#include "FieldSyncMessages.h"
+
+#include <ArduinoJson.h>
+
+namespace fieldsync {
+
+namespace {
+// ArduinoJson writes control characters other than \b \f \n \r \t raw, which
+// JSON.parse() on the phone rejects. Outside strings JSON has none, so every one
+// left is inside a string and becomes a \u00XX escape.
+std::string serialize(const JsonDocument& doc) {
+  std::string raw;
+  serializeJson(doc, raw);
+  size_t controls = 0;
+  for (const char c : raw) controls += static_cast<unsigned char>(c) < 0x20 ? 1 : 0;
+  if (controls == 0) return raw;
+  static constexpr char HEX_DIGITS[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(raw.size() + controls * 5);
+  for (const char c : raw) {
+    const auto byte = static_cast<unsigned char>(c);
+    if (byte >= 0x20) {
+      out.push_back(c);
+      continue;
+    }
+    out.append("\\u00");
+    out.push_back(HEX_DIGITS[byte >> 4]);
+    out.push_back(HEX_DIGITS[byte & 0x0F]);
+  }
+  return out;
+}
+}  // namespace
+
+std::string buildHello(const char* device, const char* firmware, const std::string& baseUrl) {
+  JsonDocument doc;
+  doc["t"] = "hello";
+  doc["v"] = PROTOCOL_VERSION;
+  doc["device"] = device;
+  doc["fw"] = firmware;
+  doc["baseUrl"] = baseUrl;
+  return serialize(doc);
+}
+
+std::string buildRequest(const uint16_t id, const KOSyncRequest& request) {
+  JsonDocument doc;
+  doc["t"] = "req";
+  doc["id"] = id;
+  doc["method"] = request.method;
+  doc["path"] = request.path;
+  JsonObject headers = doc["headers"].to<JsonObject>();
+  for (const auto& header : request.headers) headers[header.first] = header.second;
+  if (request.body) {
+    doc["body"] = *request.body;
+  } else {
+    doc["body"] = nullptr;
+  }
+  return serialize(doc);
+}
+
+std::string buildBye(const char* reason) {
+  JsonDocument doc;
+  doc["t"] = "bye";
+  doc["reason"] = reason;
+  return serialize(doc);
+}
+
+std::string buildError(const char* code, const char* message) {
+  JsonDocument doc;
+  doc["t"] = "error";
+  doc["code"] = code;
+  if (message && message[0] != '\0') doc["message"] = message;
+  return serialize(doc);
+}
+
+Incoming parseIncoming(const std::string& json) {
+  Incoming in;
+  JsonDocument doc;
+  if (deserializeJson(doc, json) != DeserializationError::Ok || !doc.is<JsonObjectConst>()) return in;
+  const char* t = doc["t"].as<const char*>();
+  if (t == nullptr) return in;
+  const std::string type(t);
+
+  if (type == "hello") {
+    in.type = MessageType::Hello;
+    in.version = doc["v"].is<int>() ? doc["v"].as<int>() : 0;
+  } else if (type == "res") {
+    in.type = MessageType::Response;
+    const JsonVariantConst id = doc["id"];
+    const JsonVariantConst status = doc["status"];
+    // A res without a numeric id and status cannot be matched or mapped.
+    if (!id.is<uint32_t>() || !status.is<int>()) {
+      in.type = MessageType::Invalid;
+      return in;
+    }
+    in.id = id.as<uint32_t>();
+    in.status = status.as<int>();
+    if (doc["body"].is<const char*>()) {
+      in.hasBody = true;
+      in.body = doc["body"].as<const char*>();
+    }
+    if (doc["error"].is<const char*>()) in.error = doc["error"].as<const char*>();
+  } else if (type == "bye") {
+    in.type = MessageType::Bye;
+    if (doc["reason"].is<const char*>()) in.text = doc["reason"].as<const char*>();
+  } else if (type == "error") {
+    in.type = MessageType::Error;
+    if (doc["code"].is<const char*>()) in.code = doc["code"].as<const char*>();
+    if (doc["message"].is<const char*>()) in.text = doc["message"].as<const char*>();
+  } else {
+    in.type = MessageType::Unknown;
+  }
+  return in;
+}
+
+}  // namespace fieldsync
diff --git a/lib/FieldBleSync/src/FieldSyncRelay.cpp b/lib/FieldBleSync/src/FieldSyncRelay.cpp
new file mode 100644
index 0000000..f2ee30f
--- /dev/null
+++ b/lib/FieldBleSync/src/FieldSyncRelay.cpp
@@ -0,0 +1,65 @@
+#include "FieldSyncRelay.h"
+
+#include <utility>
+
+#include "FieldSyncMessages.h"
+
+namespace fieldsync {
+
+int RelayTransport::perform(const KOSyncRequest& request, std::string* responseBody) {
+  error.clear();
+  if (responseBody) responseBody->clear();
+  if (linkClosed) {
+    error = "closed";
+    return -1;
+  }
+
+  const uint16_t id = nextId;
+  nextId = nextId == UINT16_MAX ? 1 : static_cast<uint16_t>(nextId + 1);
+  if (!link.send(buildRequest(id, request))) {
+    error = "send";
+    return -1;
+  }
+
+  const uint32_t startMs = link.nowMs();
+  std::string message;
+  for (;;) {
+    const uint32_t elapsed = link.nowMs() - startMs;
+    if (elapsed >= timeoutMs) {
+      error = "timeout";
+      return -1;
+    }
+    switch (link.receive(message, timeoutMs - elapsed)) {
+      case RelayLink::Wait::Timeout:
+        continue;  // the loop head ends the wait once the budget is spent
+      case RelayLink::Wait::Closed:
+        linkClosed = true;
+        error = "closed";
+        return -1;
+      case RelayLink::Wait::Message:
+        break;
+    }
+
+    Incoming in = parseIncoming(message);
+    switch (in.type) {
+      case MessageType::Response:
+        // A late answer to an earlier, timed-out request is dropped.
+        if (in.id != id) continue;
+        if (in.status <= 0) {
+          error = in.error.empty() ? "network" : in.error;
+          return 0;
+        }
+        if (responseBody && in.hasBody) *responseBody = std::move(in.body);
+        return in.status;
+      case MessageType::Bye:
+      case MessageType::Error:
+        linkClosed = true;
+        error = in.type == MessageType::Bye ? "bye" : (in.code.empty() ? "error" : in.code);
+        return -1;
+      default:
+        continue;  // hello repeats, unknown types and malformed JSON do not answer this request
+    }
+  }
+}
+
+}  // namespace fieldsync

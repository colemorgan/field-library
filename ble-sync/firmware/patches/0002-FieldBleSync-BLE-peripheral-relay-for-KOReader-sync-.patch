+++ b/lib/FieldBleSync/test/MessagesTest.cpp
@@ -0,0 +1,121 @@
+#include <ArduinoJson.h>
+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "FieldSyncMessages.h"
+
+using fieldsync::Incoming;
+using fieldsync::MessageType;
+
+TEST(FieldSyncMessages, HelloMatchesTheSpecShape) {
+  EXPECT_EQ(fieldsync::buildHello("CrossPoint", "1.6.5-field-ble", "https://sync.crosspointreader.com"),
+            "{\"t\":\"hello\",\"v\":1,\"device\":\"CrossPoint\",\"fw\":\"1.6.5-field-ble\","
+            "\"baseUrl\":\"https://sync.crosspointreader.com\"}");
+}
+
+TEST(FieldSyncMessages, GetRequestHasNullBody) {
+  KOSyncRequest req;
+  req.method = "GET";
+  req.path = "/syncs/progress/0123abcd?position_kinds=locator,percentage";
+  req.headers = {{"Accept", "application/vnd.koreader.v1+json"}, {"x-auth-user", "cole"}, {"x-auth-key", "md5"}};
+  EXPECT_EQ(
+      fieldsync::buildRequest(1, req),
+      "{\"t\":\"req\",\"id\":1,\"method\":\"GET\","
+      "\"path\":\"/syncs/progress/0123abcd?position_kinds=locator,percentage\","
+      "\"headers\":{\"Accept\":\"application/vnd.koreader.v1+json\",\"x-auth-user\":\"cole\",\"x-auth-key\":\"md5\"},"
+      "\"body\":null}");
+}
+
+TEST(FieldSyncMessages, MatchesTheUtf8Vector) {
+  KOSyncRequest req;
+  req.path = "/syncs/progress/abc";
+  req.headers = {{"x-auth-user", "Zo\xC3\xAB"}};
+  EXPECT_EQ(fieldsync::buildRequest(1, req),
+            "{\"t\":\"req\",\"id\":1,\"method\":\"GET\",\"path\":\"/syncs/progress/abc\","
+            "\"headers\":{\"x-auth-user\":\"Zo\xC3\xAB\"},\"body\":null}");
+}
+
+TEST(FieldSyncMessages, EscapesHeadersAndBodyAndRoundTrips) {
+  const std::string body = "{\"document\":\"a\\\"b\",\"progress\":\"/body/DocFragment[2]\"}\n\t\x01";
+  KOSyncRequest req;
+  req.method = "PUT";
+  req.path = "/syncs/progress";
+  req.headers = {{"x-auth-user", "we\"ird\\name"}, {"X-Custom", "line1\r\nline2"}};
+  req.body = &body;
+  const std::string json = fieldsync::buildRequest(65535, req);
+
+  // No raw control characters may reach the wire.
+  for (const char c : json) EXPECT_GE(static_cast<unsigned char>(c), 0x20) << json;
+
+  JsonDocument doc;
+  ASSERT_EQ(deserializeJson(doc, json), DeserializationError::Ok);
+  EXPECT_STREQ(doc["t"], "req");
+  EXPECT_EQ(doc["id"].as<int>(), 65535);
+  EXPECT_STREQ(doc["method"], "PUT");
+  EXPECT_EQ(doc["headers"]["x-auth-user"].as<std::string>(), "we\"ird\\name");
+  EXPECT_EQ(doc["headers"]["X-Custom"].as<std::string>(), "line1\r\nline2");
+  EXPECT_EQ(doc["body"].as<std::string>(), body);
+}
+
+TEST(FieldSyncMessages, ByeAndError) {
+  EXPECT_EQ(fieldsync::buildBye("done"), "{\"t\":\"bye\",\"reason\":\"done\"}");
+  EXPECT_EQ(fieldsync::buildError("version", nullptr), "{\"t\":\"error\",\"code\":\"version\"}");
+  EXPECT_EQ(fieldsync::buildError("too_large", "x"), "{\"t\":\"error\",\"code\":\"too_large\",\"message\":\"x\"}");
+}
+
+TEST(FieldSyncMessages, ParsesResponseWithBody) {
+  const Incoming in = fieldsync::parseIncoming(
+      "{\"t\":\"res\",\"id\":7,\"status\":200,\"body\":\"{\\\"document\\\":\\\"0123abcd\\\"}\"}");
+  EXPECT_EQ(in.type, MessageType::Response);
+  EXPECT_EQ(in.id, 7u);
+  EXPECT_EQ(in.status, 200);
+  EXPECT_TRUE(in.hasBody);
+  EXPECT_EQ(in.body, "{\"document\":\"0123abcd\"}");
+  EXPECT_TRUE(in.error.empty());
+}
+
+TEST(FieldSyncMessages, ParsesNullBodyAndStatusZeroErrors) {
+  const Incoming nullBody = fieldsync::parseIncoming("{\"t\":\"res\",\"id\":2,\"status\":204,\"body\":null}");
+  EXPECT_EQ(nullBody.type, MessageType::Response);
+  EXPECT_FALSE(nullBody.hasBody);
+  EXPECT_EQ(nullBody.status, 204);
+
+  for (const char* code : {"network", "timeout", "origin_not_allowed", "bad_request", "too_large"}) {
+    const Incoming in = fieldsync::parseIncoming(std::string("{\"t\":\"res\",\"id\":3,\"status\":0,\"error\":\"") +
+                                                 code + "\",\"body\":null}");
+    EXPECT_EQ(in.type, MessageType::Response);
+    EXPECT_EQ(in.status, 0);
+    EXPECT_EQ(in.error, code);
+  }
+}
+
+TEST(FieldSyncMessages, RejectsResponsesItCannotMatch) {
+  EXPECT_EQ(fieldsync::parseIncoming("{\"t\":\"res\",\"status\":200}").type, MessageType::Invalid);
+  EXPECT_EQ(fieldsync::parseIncoming("{\"t\":\"res\",\"id\":\"1\",\"status\":200}").type, MessageType::Invalid);
+  EXPECT_EQ(fieldsync::parseIncoming("{\"t\":\"res\",\"id\":1}").type, MessageType::Invalid);
+}
+
+TEST(FieldSyncMessages, ParsesHelloByeErrorAndUnknown) {
+  const Incoming hello =
+      fieldsync::parseIncoming("{\"t\":\"hello\",\"v\":1,\"app\":\"field-sync-web\",\"appVersion\":\"0.1.0\"}");
+  EXPECT_EQ(hello.type, MessageType::Hello);
+  EXPECT_EQ(hello.version, 1);
+  EXPECT_TRUE(fieldsync::versionCompatible(hello.version));
+  EXPECT_FALSE(fieldsync::versionCompatible(fieldsync::parseIncoming("{\"t\":\"hello\",\"v\":2}").version));
+  EXPECT_FALSE(fieldsync::versionCompatible(fieldsync::parseIncoming("{\"t\":\"hello\"}").version));
+
+  const Incoming bye = fieldsync::parseIncoming("{\"t\":\"bye\",\"reason\":\"user\"}");
+  EXPECT_EQ(bye.type, MessageType::Bye);
+  EXPECT_EQ(bye.text, "user");
+
+  const Incoming err = fieldsync::parseIncoming("{\"t\":\"error\",\"code\":\"version\",\"message\":\"m\"}");
+  EXPECT_EQ(err.type, MessageType::Error);
+  EXPECT_EQ(err.code, "version");
+  EXPECT_EQ(err.text, "m");
+
+  EXPECT_EQ(fieldsync::parseIncoming("{\"t\":\"ping\"}").type, MessageType::Unknown);
+  EXPECT_EQ(fieldsync::parseIncoming("not json").type, MessageType::Invalid);
+  EXPECT_EQ(fieldsync::parseIncoming("[1,2]").type, MessageType::Invalid);
+  EXPECT_EQ(fieldsync::parseIncoming("{\"x\":1}").type, MessageType::Invalid);
+}
diff --git a/lib/FieldBleSync/test/RelayTransportTest.cpp b/lib/FieldBleSync/test/RelayTransportTest.cpp
new file mode 100644
index 0000000..e034605
--- /dev/null
+++ b/lib/FieldBleSync/test/RelayTransportTest.cpp
@@ -0,0 +1,212 @@
+#include <ArduinoJson.h>
+#include <gtest/gtest.h>
+
+#include <deque>
+#include <string>
+#include <vector>
+
+#include "FieldSyncRelay.h"
+
+using fieldsync::RelayLink;
+using fieldsync::RelayTransport;
+
+namespace {
+
+// A scripted phone: each step answers the next request, or plays a link event.
+class FakeLink final : public RelayLink {
+ public:
+  struct Step {
+    enum Kind { Reply, Close, Silence } kind;
+    std::string message;   // Reply
+    uint32_t delayMs = 0;  // time that passes before this step
+  };
+
+  bool connected = true;
+  uint32_t clock = 0;
+  std::vector<std::string> sent;
+  std::deque<Step> script;
+  int receives = 0;
+
+  bool send(const std::string& message) override {
+    if (!connected) return false;
+    sent.push_back(message);
+    return true;
+  }
+
+  Wait receive(std::string& out, const uint32_t timeoutMs) override {
+    ++receives;
+    if (script.empty() || script.front().kind == Step::Silence) {
+      clock += timeoutMs;
+      if (!script.empty()) script.pop_front();
+      return Wait::Timeout;
+    }
+    Step step = script.front();
+    script.pop_front();
+    if (step.delayMs > timeoutMs) {
+      clock += timeoutMs;
+      script.push_front(Step{step.kind, step.message, step.delayMs - timeoutMs});
+      return Wait::Timeout;
+    }
+    clock += step.delayMs;
+    if (step.kind == Step::Close) {
+      connected = false;
+      return Wait::Closed;
+    }
+    out = step.message;
+    return Wait::Message;
+  }
+
+  uint32_t nowMs() override { return clock; }
+
+  void reply(const std::string& message, const uint32_t delayMs = 0) {
+    script.push_back(Step{Step::Reply, message, delayMs});
+  }
+};
+
+KOSyncRequest getRequest() {
+  KOSyncRequest req;
+  req.path = "/users/auth";
+  req.headers = {{"x-auth-user", "cole"}};
+  return req;
+}
+
+int sentId(const std::string& json) {
+  JsonDocument doc;
+  EXPECT_EQ(deserializeJson(doc, json), DeserializationError::Ok);
+  return doc["id"].as<int>();
+}
+
+}  // namespace
+
+TEST(FieldSyncRelay, SendsRequestAndReturnsMatchingResponse) {
+  FakeLink link;
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":200,\"body\":\"{\\\"ok\\\":true}\"}", 120);
+  RelayTransport transport(link);
+  std::string body;
+  EXPECT_EQ(transport.perform(getRequest(), &body), 200);
+  EXPECT_EQ(body, "{\"ok\":true}");
+  ASSERT_EQ(link.sent.size(), 1u);
+  EXPECT_EQ(
+      link.sent[0],
+      "{\"t\":\"req\",\"id\":1,\"method\":\"GET\",\"path\":\"/users/auth\",\"headers\":{\"x-auth-user\":\"cole\"},"
+      "\"body\":null}");
+  EXPECT_FALSE(transport.needsTlsHeap());
+}
+
+TEST(FieldSyncRelay, IdsIncreaseAndWrapPast65535) {
+  FakeLink link;
+  RelayTransport transport(link);
+  for (int i = 1; i <= 65536; ++i) {
+    const int expected = i == 65536 ? 1 : i;
+    link.reply("{\"t\":\"res\",\"id\":" + std::to_string(expected) + ",\"status\":200,\"body\":null}");
+    ASSERT_EQ(transport.perform(getRequest(), nullptr), 200) << i;
+    ASSERT_EQ(sentId(link.sent.back()), expected);
+    link.sent.clear();
+  }
+}
+
+TEST(FieldSyncRelay, SkipsStaleResponsesAndOtherMessages) {
+  FakeLink link;
+  RelayTransport transport(link);
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":200,\"body\":null}");
+  ASSERT_EQ(transport.perform(getRequest(), nullptr), 200);
+
+  // Request 2: a late duplicate for id 1, junk, a repeated hello, then the answer.
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":500,\"body\":null}");
+  link.reply("garbage");
+  link.reply("{\"t\":\"hello\",\"v\":1}");
+  link.reply("{\"t\":\"res\",\"id\":2,\"status\":404,\"body\":null}");
+  std::string body = "stale";
+  EXPECT_EQ(transport.perform(getRequest(), &body), 404);
+  EXPECT_TRUE(body.empty());
+}
+
+TEST(FieldSyncRelay, StatusZeroMapsToNetworkErrorWithCode) {
+  FakeLink link;
+  RelayTransport transport(link);
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":0,\"error\":\"origin_not_allowed\",\"body\":null}");
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), 0);
+  EXPECT_EQ(transport.lastError(), "origin_not_allowed");
+  EXPECT_FALSE(transport.closed());
+
+  link.reply("{\"t\":\"res\",\"id\":2,\"status\":0}");
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), 0);
+  EXPECT_EQ(transport.lastError(), "network");
+}
+
+TEST(FieldSyncRelay, TimesOutAfterThirtySeconds) {
+  FakeLink link;
+  RelayTransport transport(link);
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":200,\"body\":null}", 30001);
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+  EXPECT_EQ(transport.lastError(), "timeout");
+  EXPECT_GE(link.clock, fieldsync::RESPONSE_TIMEOUT_MS);
+  EXPECT_LT(link.clock, fieldsync::RESPONSE_TIMEOUT_MS + 10);
+  EXPECT_FALSE(transport.closed());
+
+  // The late answer to id 1 is then ignored by request 2.
+  link.reply("{\"t\":\"res\",\"id\":2,\"status\":200,\"body\":null}");
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), 200);
+}
+
+TEST(FieldSyncRelay, ResponseJustInsideTheWindowIsAccepted) {
+  FakeLink link;
+  RelayTransport transport(link);
+  link.reply("{\"t\":\"hello\",\"v\":1}", 10000);
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":201,\"body\":null}", 19999);
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), 201);
+}
+
+TEST(FieldSyncRelay, ClosedLinkFailsThisAndLaterRequests) {
+  FakeLink link;
+  RelayTransport transport(link);
+  link.script.push_back({FakeLink::Step::Close, "", 50});
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+  EXPECT_TRUE(transport.closed());
+  const size_t sentBefore = link.sent.size();
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+  EXPECT_EQ(link.sent.size(), sentBefore);  // nothing is sent on a closed link
+}
+
+TEST(FieldSyncRelay, ByeOrErrorFromPhoneEndsTheRelay) {
+  {
+    FakeLink link;
+    RelayTransport transport(link);
+    link.reply("{\"t\":\"bye\",\"reason\":\"user\"}");
+    EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+    EXPECT_TRUE(transport.closed());
+    EXPECT_EQ(transport.lastError(), "bye");
+  }
+  {
+    FakeLink link;
+    RelayTransport transport(link);
+    link.reply("{\"t\":\"error\",\"code\":\"version\"}");
+    EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+    EXPECT_TRUE(transport.closed());
+    EXPECT_EQ(transport.lastError(), "version");
+  }
+}
+
+TEST(FieldSyncRelay, SendFailureIsANetworkError) {
+  FakeLink link;
+  link.connected = false;
+  RelayTransport transport(link);
+  EXPECT_EQ(transport.perform(getRequest(), nullptr), -1);
+  EXPECT_EQ(transport.lastError(), "send");
+}
+
+TEST(FieldSyncRelay, PutBodyIsRelayedVerbatim) {
+  FakeLink link;
+  RelayTransport transport(link);
+  const std::string body = "{\"document\":\"x\",\"percentage\":0.5}";
+  KOSyncRequest req;
+  req.method = "PUT";
+  req.path = "/syncs/progress";
+  req.body = &body;
+  link.reply("{\"t\":\"res\",\"id\":1,\"status\":200,\"body\":\"{}\"}");
+  EXPECT_EQ(transport.perform(req, nullptr), 200);
+  JsonDocument doc;
+  ASSERT_EQ(deserializeJson(doc, link.sent[0]), DeserializationError::Ok);
+  EXPECT_STREQ(doc["method"], "PUT");
+  EXPECT_EQ(doc["body"].as<std::string>(), body);
+}

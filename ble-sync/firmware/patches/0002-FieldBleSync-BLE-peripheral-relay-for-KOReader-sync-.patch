+# Host tests for the Field Sync relay: framing, messages and the relay transport.
+# Runs from the firmware host suite (test/CMakeLists.txt) or on its own:
+# cmake -S lib/FieldBleSync/test -B build/fs && cmake --build build/fs && ctest --test-dir build/fs
+cmake_minimum_required(VERSION 3.16)
+project(field_ble_sync_tests CXX)
+
+if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
+  set(CMAKE_CXX_STANDARD 20)
+  set(CMAKE_CXX_STANDARD_REQUIRED ON)
+  set(CMAKE_CXX_EXTENSIONS OFF)
+  enable_testing()
+endif()
+
+include(FetchContent)
+if(NOT TARGET GTest::gtest_main)
+  FetchContent_Declare(googletest GIT_REPOSITORY https://github.com/google/googletest.git GIT_TAG v1.17.0)
+  set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
+  set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
+  set(BUILD_GMOCK OFF CACHE BOOL "" FORCE)
+  FetchContent_MakeAvailable(googletest)
+endif()
+include(GoogleTest)
+
+# ArduinoJson at the version the firmware pins (platformio.ini: bblanchon/ArduinoJson @ 7.4.2).
+FetchContent_Declare(arduinojson GIT_REPOSITORY https://github.com/bblanchon/ArduinoJson.git GIT_TAG v7.4.2
+                     SOURCE_SUBDIR no-build)
+FetchContent_MakeAvailable(arduinojson)
+
+get_filename_component(FIELDSYNC_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
+
+add_executable(FieldBleSyncTest
+  FramingTest.cpp
+  MessagesTest.cpp
+  RelayTransportTest.cpp
+  ${FIELDSYNC_ROOT}/src/FieldSyncFraming.cpp
+  ${FIELDSYNC_ROOT}/src/FieldSyncMessages.cpp
+  ${FIELDSYNC_ROOT}/src/FieldSyncRelay.cpp
+)
+target_include_directories(FieldBleSyncTest PRIVATE
+  ${FIELDSYNC_ROOT}/include
+  ${FIELDSYNC_ROOT}/../KOReaderSync
+)
+target_include_directories(FieldBleSyncTest SYSTEM PRIVATE ${arduinojson_SOURCE_DIR}/src)
+target_compile_definitions(FieldBleSyncTest PRIVATE FIELDSYNC_VECTORS_PATH="${FIELDSYNC_ROOT}/test/vectors.json")
+target_compile_options(FieldBleSyncTest PRIVATE -Wall -Wextra -Werror)
+target_link_libraries(FieldBleSyncTest PRIVATE GTest::gtest_main)
+gtest_discover_tests(FieldBleSyncTest)
diff --git a/lib/FieldBleSync/test/FramingTest.cpp b/lib/FieldBleSync/test/FramingTest.cpp
new file mode 100644
index 0000000..ecf11e5
--- /dev/null
+++ b/lib/FieldBleSync/test/FramingTest.cpp
@@ -0,0 +1,225 @@
+#include <ArduinoJson.h>
+#include <gtest/gtest.h>
+
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "FieldSyncFraming.h"
+
+using fieldsync::Reassembler;
+
+namespace {
+
+std::string toHex(const std::vector<uint8_t>& bytes) {
+  static const char* digits = "0123456789abcdef";
+  std::string out;
+  for (const uint8_t b : bytes) {
+    out.push_back(digits[b >> 4]);
+    out.push_back(digits[b & 0x0F]);
+  }
+  return out;
+}
+
+std::vector<uint8_t> fromHex(const std::string& hex) {
+  std::vector<uint8_t> out;
+  for (size_t i = 0; i + 1 < hex.size(); i += 2)
+    out.push_back(static_cast<uint8_t>(std::stoul(hex.substr(i, 2), nullptr, 16)));
+  return out;
+}
+
+bool collect(const uint8_t* chunk, const size_t length, void* context) {
+  static_cast<std::vector<std::vector<uint8_t>>*>(context)->emplace_back(chunk, chunk + length);
+  return true;
+}
+
+std::vector<std::vector<uint8_t>> encode(const std::string& message, const uint8_t msgId, const uint16_t mtu) {
+  std::vector<std::vector<uint8_t>> chunks;
+  EXPECT_TRUE(fieldsync::encodeMessage(msgId, reinterpret_cast<const uint8_t*>(message.data()), message.size(), mtu,
+                                       collect, &chunks));
+  return chunks;
+}
+
+struct Vector {
+  std::string name;
+  std::string message;
+  uint8_t msgId;
+  uint16_t mtu;
+  std::vector<std::string> chunks;
+};
+
+std::vector<Vector> loadVectors() {
+  std::ifstream file(FIELDSYNC_VECTORS_PATH);
+  std::stringstream text;
+  text << file.rdbuf();
+  JsonDocument doc;
+  EXPECT_EQ(deserializeJson(doc, text.str()), DeserializationError::Ok);
+  EXPECT_EQ(doc["protocol"].as<int>(), 1);
+  EXPECT_EQ(doc["maxMessageBytes"].as<size_t>(), fieldsync::MAX_MESSAGE_BYTES);
+  std::vector<Vector> out;
+  for (JsonObjectConst v : doc["framing"].as<JsonArrayConst>()) {
+    Vector vec;
+    vec.name = v["name"].as<const char*>();
+    vec.message = v["message"].as<const char*>();
+    vec.msgId = v["msgId"].as<uint8_t>();
+    vec.mtu = v["mtu"].as<uint16_t>();
+    for (JsonVariantConst c : v["chunks"].as<JsonArrayConst>()) vec.chunks.emplace_back(c.as<const char*>());
+    out.push_back(std::move(vec));
+  }
+  return out;
+}
+
+}  // namespace
+
+TEST(FieldSyncFraming, VectorsFileHasCases) { EXPECT_EQ(loadVectors().size(), 4u); }
+
+TEST(FieldSyncFraming, EncodesEveryVectorByteForByte) {
+  for (const auto& v : loadVectors()) {
+    SCOPED_TRACE(v.name);
+    const auto chunks = encode(v.message, v.msgId, v.mtu);
+    ASSERT_EQ(chunks.size(), v.chunks.size());
+    for (size_t i = 0; i < chunks.size(); ++i) {
+      EXPECT_EQ(toHex(chunks[i]), v.chunks[i]) << "chunk " << i;
+      EXPECT_LE(chunks[i].size(), fieldsync::chunkSizeForMtu(v.mtu));
+    }
+  }
+}
+
+TEST(FieldSyncFraming, DecodesEveryVectorBackToItsMessage) {
+  for (const auto& v : loadVectors()) {
+    SCOPED_TRACE(v.name);
+    Reassembler r;
+    for (size_t i = 0; i < v.chunks.size(); ++i) {
+      const auto bytes = fromHex(v.chunks[i]);
+      const auto result = r.feed(bytes.data(), bytes.size(), static_cast<uint32_t>(i * 10));
+      if (i + 1 < v.chunks.size()) {
+        EXPECT_EQ(result, Reassembler::Result::Partial);
+      } else {
+        ASSERT_EQ(result, Reassembler::Result::Complete);
+      }
+    }
+    EXPECT_EQ(r.message(), v.message);
+  }
+}
+
+TEST(FieldSyncFraming, MinimumMtuGivesEighteenBytePayloads) {
+  EXPECT_EQ(fieldsync::chunkSizeForMtu(23), 20u);
+  EXPECT_EQ(fieldsync::chunkSizeForMtu(0), 20u);  // never below the minimum MTU
+  EXPECT_EQ(fieldsync::chunkSizeForMtu(247), 244u);
+}
+
+TEST(FieldSyncFraming, LargeMtuStillBoundsChunks) {
+  const std::string message(5000, 'x');
+  const auto chunks = encode(message, 1, 517);
+  for (const auto& c : chunks) EXPECT_LE(c.size(), 514u);
+  Reassembler r;
+  Reassembler::Result last = Reassembler::Result::Ignored;
+  for (const auto& c : chunks) last = r.feed(c.data(), c.size(), 0);
+  ASSERT_EQ(last, Reassembler::Result::Complete);
+  EXPECT_EQ(r.message(), message);
+}
+
+TEST(FieldSyncFraming, EncoderRefusesOversizeMessages) {
+  const std::string atLimit(fieldsync::MAX_MESSAGE_BYTES, 'a');
+  EXPECT_FALSE(encode(atLimit, 0, 247).empty());
+  const std::string over(fieldsync::MAX_MESSAGE_BYTES + 1, 'a');
+  std::vector<std::vector<uint8_t>> chunks;
+  EXPECT_FALSE(
+      fieldsync::encodeMessage(0, reinterpret_cast<const uint8_t*>(over.data()), over.size(), 247, collect, &chunks));
+  EXPECT_TRUE(chunks.empty());
+}
+
+TEST(FieldSyncFraming, ReassemblesExactlyTheLimitButDropsOneByteMore) {
+  {
+    const std::string atLimit(fieldsync::MAX_MESSAGE_BYTES, 'a');
+    Reassembler r;
+    Reassembler::Result last = Reassembler::Result::Ignored;
+    for (const auto& c : encode(atLimit, 3, 247)) last = r.feed(c.data(), c.size(), 0);
+    EXPECT_EQ(last, Reassembler::Result::Complete);
+    EXPECT_EQ(r.message().size(), fieldsync::MAX_MESSAGE_BYTES);
+  }
+  {
+    // Hand-built chunks: the encoder itself refuses to produce this message.
+    Reassembler r;
+    std::vector<uint8_t> chunk(2 + 200, 'b');
+    chunk[1] = 9;
+    Reassembler::Result result = Reassembler::Result::Partial;
+    size_t sent = 0;
+    bool first = true;
+    while (result == Reassembler::Result::Partial) {
+      chunk[0] = first ? fieldsync::FLAG_FIRST : 0;
+      first = false;
+      result = r.feed(chunk.data(), chunk.size(), 0);
+      sent += 200;
+    }
+    EXPECT_EQ(result, Reassembler::Result::TooLarge);
+    EXPECT_GT(sent, fieldsync::MAX_MESSAGE_BYTES);
+    EXPECT_FALSE(r.inProgress());
+    // The rest of the dropped message is ignored, even its LAST chunk.
+    chunk[0] = fieldsync::FLAG_LAST;
+    EXPECT_EQ(r.feed(chunk.data(), chunk.size(), 0), Reassembler::Result::Ignored);
+  }
+}
+
+TEST(FieldSyncFraming, GapOverFiveSecondsDiscardsThePartialMessage) {
+  const auto chunks = encode("{\"t\":\"hello\",\"v\":1,\"app\":\"field-sync-web\"}", 4, 23);
+  ASSERT_GE(chunks.size(), 3u);
+  Reassembler r;
+  EXPECT_EQ(r.feed(chunks[0].data(), chunks[0].size(), 1000), Reassembler::Result::Partial);
+  EXPECT_EQ(r.feed(chunks[1].data(), chunks[1].size(), 6000), Reassembler::Result::Partial);  // exactly 5 s: kept
+  EXPECT_EQ(r.feed(chunks[2].data(), chunks[2].size(), 11001), Reassembler::Result::Ignored);
+  EXPECT_FALSE(r.inProgress());
+}
+
+TEST(FieldSyncFraming, ExpireDropsStalePartialWithoutAChunk) {
+  const auto chunks = encode(std::string(100, 'z'), 4, 23);
+  Reassembler r;
+  r.feed(chunks[0].data(), chunks[0].size(), 0);
+  EXPECT_FALSE(r.expire(5000));
+  EXPECT_TRUE(r.inProgress());
+  EXPECT_TRUE(r.expire(5001));
+  EXPECT_FALSE(r.inProgress());
+}
+
+TEST(FieldSyncFraming, FirstChunkResetsAPartialMessage) {
+  const auto stale = encode(std::string(60, 's'), 1, 23);
+  const auto fresh = encode("{\"t\":\"bye\",\"r\":1}", 2, 23);
+  Reassembler r;
+  EXPECT_EQ(r.feed(stale[0].data(), stale[0].size(), 0), Reassembler::Result::Partial);
+  EXPECT_EQ(r.feed(stale[1].data(), stale[1].size(), 0), Reassembler::Result::Partial);
+  ASSERT_EQ(fresh.size(), 1u);
+  EXPECT_EQ(r.feed(fresh[0].data(), fresh[0].size(), 0), Reassembler::Result::Complete);
+  EXPECT_EQ(r.message(), "{\"t\":\"bye\",\"r\":1}");
+  // FIRST with the same msgId as the partial one also starts over.
+  const auto again = encode(std::string(60, 'q'), 1, 23);
+  r.feed(stale[0].data(), stale[0].size(), 0);
+  Reassembler::Result last = Reassembler::Result::Ignored;
+  for (const auto& c : again) last = r.feed(c.data(), c.size(), 0);
+  EXPECT_EQ(last, Reassembler::Result::Complete);
+  EXPECT_EQ(r.message(), std::string(60, 'q'));
+}
+
+TEST(FieldSyncFraming, IgnoresOrphanAndMismatchedChunks) {
+  Reassembler r;
+  const uint8_t orphan[] = {0x02, 0x05, 'x'};
+  EXPECT_EQ(r.feed(orphan, sizeof(orphan), 0), Reassembler::Result::Ignored);
+  const uint8_t tooShort[] = {0x03};
+  EXPECT_EQ(r.feed(tooShort, sizeof(tooShort), 0), Reassembler::Result::Ignored);
+  const uint8_t first[] = {0x01, 0x05, 'a'};
+  const uint8_t otherId[] = {0x02, 0x06, 'b'};
+  EXPECT_EQ(r.feed(first, sizeof(first), 0), Reassembler::Result::Partial);
+  EXPECT_EQ(r.feed(otherId, sizeof(otherId), 0), Reassembler::Result::Ignored);
+  EXPECT_FALSE(r.inProgress());
+}
+
+TEST(FieldSyncFraming, SplitUtf8SequenceSurvivesReassembly) {
+  // "Zoë": the two bytes of ë land in different chunks at MTU 23 in the vectors; check a direct split too.
+  const std::string message = "{\"u\":\"Zo\xC3\xAB\"}";
+  const uint8_t a[] = {0x01, 0x01, '{', '"', 'u', '"', ':', '"', 'Z', 'o', 0xC3};
+  const uint8_t b[] = {0x02, 0x01, 0xAB, '"', '}'};
+  Reassembler r;
+  EXPECT_EQ(r.feed(a, sizeof(a), 0), Reassembler::Result::Partial);
+  EXPECT_EQ(r.feed(b, sizeof(b), 0), Reassembler::Result::Complete);
+  EXPECT_EQ(r.message(), message);
+}
diff --git a/lib/FieldBleSync/test/MessagesTest.cpp b/lib/FieldBleSync/test/MessagesTest.cpp
